# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URL (OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mercado Pago OAuth (https://www.mercadopago.com.ar/developers)
# En la app MP, Redirect URI debe ser exactamente:
# http://localhost:3000/api/mercadopago/callback
MP_CLIENT_ID=your_app_id
MP_CLIENT_SECRET=your_client_secret
MP_REDIRECT_URI=http://localhost:3000/api/mercadopago/callback
# Opcional: true solo si habilitaste PKCE en la app de MP
# MP_USE_PKCE=true

# Cobranzas (módulo Coco Soft)
# Secreto que Vercel manda como "Authorization: Bearer ..." a los crons (generá uno largo y aleatorio)
CRON_SECRET=
# id de tu usuario en auth.users; el cron solo opera sobre sus datos
BILLING_OWNER_USER_ID=
# Datos de transferencia que se muestran en el mensaje de WhatsApp
BILLING_PAYMENT_ALIAS=
# Alias para recibir dólares (aparece en el mensaje de WhatsApp)
BILLING_PAYMENT_ALIAS_USD=
BILLING_PAYMENT_HOLDER=
# Token personal de Supabase (Management API). Solo servidor, nunca NEXT_PUBLIC_
SUPABASE_ACCESS_TOKEN=
# Cotización del USD de respaldo si falla la API del dólar blue (opcional, por defecto 1560)
BILLING_DEFAULT_USD_RATE=1560
