# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URL (OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mercado Pago OAuth (https://www.mercadopago.com.ar/developers)
# En la app MP, Redirect URI debe ser exactamente:
# http://localhost:3000/api/mercadopago/callback
MP_CLIENT_ID=your_app_id
MP_CLIENT_SECRET=your_client_secret
MP_REDIRECT_URI=http://localhost:3000/api/mercadopago/callback
# Opcional: true solo si habilitaste PKCE en la app de MP
# MP_USE_PKCE=true
